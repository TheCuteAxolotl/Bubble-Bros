# Bubbles & Bros. — fresh Vercel project
# Copy to .env.local for local development. Never commit real secrets.

# REQUIRED: PostgreSQL / Prisma database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# REQUIRED: use a long random value (example command: openssl rand -base64 48)
NEXTAUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# REQUIRED after the first Vercel deployment
NEXT_PUBLIC_SITE_URL="https://YOUR-VERCEL-PROJECT.vercel.app"

# OWNER / BRAND
NEXT_PUBLIC_OWNER_EMAIL="kongkaeow5@gmail.com"
OWNER_EMAIL="kongkaeow5@gmail.com"
OWNER_NAME="Bubbles & Bros. Owner"
OWNER_PASSWORD="CHOOSE_A_STRONG_PASSWORD_FOR_THE_INITIAL_OWNER_ACCOUNT"

NEXT_PUBLIC_BUSINESS_NAME="Bubbles & Bros."
NEXT_PUBLIC_BUSINESS_SHORT_NAME="Bubbles & Bros."
NEXT_PUBLIC_BUSINESS_TAGLINE="Because We Care."
NEXT_PUBLIC_BUSINESS_EMAIL="kongkaeow5@gmail.com"

# Leave blank until the owner tells you the service area.
NEXT_PUBLIC_SERVICE_AREA=""

# Intentionally disabled for this first version.
NEXT_PUBLIC_ENABLE_PHONE="false"
NEXT_PUBLIC_ENABLE_SMS="false"
NEXT_PUBLIC_ENABLE_GOOGLE_REVIEWS="false"

# Optional later — only fill these in when the business is ready.
NEXT_PUBLIC_BUSINESS_PHONE=""
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=""
NEXT_PUBLIC_GOOGLE_REVIEW_URL=""
